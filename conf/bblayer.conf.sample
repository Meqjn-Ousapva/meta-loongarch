# POKY_BBLAYERS_CONF_VERSION is increased each time build/conf/bblayers.conf
# changes incompatibly
POKY_BBLAYERS_CONF_VERSION = "2"

BBPATH = "${TOPDIR}"
BBFILES ?= ""

BBLAYERS ?= " \
  /home/meqjn/yoctoproject/meta-loongarch-openeuler \
  /home/meqjn/openeulerproject/yocto-poky/meta \
  /home/meqjn/openeulerproject/yocto-meta-openembedded/meta-oe \
  /home/meqjn/openeulerproject/yocto-meta-openembedded/meta-python \
  /home/meqjn/openeulerproject/yocto-meta-openembedded/meta-networking \
  /home/meqjn/openeulerproject/yocto-meta-openembedded/meta-filesystems \
  /home/meqjn/openeulerproject/yocto-meta-openeuler/meta-openeuler \
  /home/meqjn/openeulerproject/yocto-meta-openeuler/bsp/meta-openeuler-bsp \
  "
